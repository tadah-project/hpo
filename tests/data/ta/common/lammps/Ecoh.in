# Ecoh.in -- minimal cohesive-energy script of the HPO tests.
#
# Computes E_iso (free atom) - E_bulk_per_atom for a 4x4x4 BCC supercell.
# Exposes:
#   varloss Ecoh   -- used by HPO as a target loss term
#   hotvar  hot_a0 -- relaxed lattice constant; HPO reads it back and
#                   caches it as the warm-start seed for the next eval.
#
# Honors ${hot_a0} as the initial lattice guess (HPO injects it before
# the script runs, then re-reads it via get_variable after minimise).

# ---------- Isolated atom ----------
clear
units metal
dimension 3
boundary f f f
atom_style atomic
atom_modify map array

region box block -10 10 -10 10 -10 10
create_box 1 box
create_atoms 1 single 0 0 0

pair_style tadah
pair_coeff * * EXTERN Ta
mass 1 180.95
neighbor 2.0 bin
neigh_modify delay 10 check yes

compute eng all pe/atom
compute eatoms all reduce sum c_eng

run 0

# Capture E_iso exactly. An internal-style variable holds the double
# itself; ${name} and v_name of an equal-style variable carry only 15
# significant digits. Eiso stays equal-style: HPO reads it (--outvar Eiso).
variable Eiso_i internal $(c_eatoms)
variable Eiso equal v_Eiso_i

# ---------- Relaxed bulk ----------
clear
units metal
dimension 3
boundary p p p
atom_style atomic
atom_modify map array

# ${hot_a0} would print the injected value with 15 digits; a format-style
# copy prints all 17.
variable hot_a0_s format hot_a0 %.17g
lattice bcc ${hot_a0_s}
region box block 0 4 0 4 0 4 units lattice
create_box 1 box
create_atoms 1 region box

pair_style tadah
pair_coeff * * EXTERN Ta
mass 1 180.95
neighbor 2.0 bin
neigh_modify delay 10 check yes

compute eng all pe/atom
compute eatoms all reduce sum c_eng

fix 1 all box/relax iso 0.0 vmax 0.001
min_style cg
min_modify dmax 0.01 line quadratic
minimize 1e-12 1e-12 500 500
unfix 1
variable eq_ok equal ternary($(fmax) < 0.1, 1, 0)

# hot_a0 is redefined to the relaxed lattice so that HPO's get_variable()
# reads back the converged value (not the seed it injected before the run).
# HPO injects hotvars as equal-style, so this is a same-style overwrite
# that LAMMPS accepts without a prior `variable delete`.
variable hot_a0 equal lx/4.0

# Exact captures and one formula over them: every variable HPO reads
# (Ecoh, Eiso, Ebulk, hot_a0) is equal-style, and none is built from
# another equal-style variable.
variable N_i internal $(atoms)
variable Ebulk_i internal $(c_eatoms)
variable Ebulk equal v_Ebulk_i
variable Ecoh equal ternary(v_eq_ok, -(v_Ebulk_i-v_N_i*v_Eiso_i)/v_N_i, 100.0)
