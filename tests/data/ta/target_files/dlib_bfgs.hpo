# DLIB:BFGS over one search parameter (RCUT2B), started at the value of
# ../common/config.tadah, with a validation energy term (PC_ERMSE) and a
# LAMMPS cohesive-energy target (PC_LAMMPS, ../common/lammps/Ecoh.in).
# The MPI end-to-end test (tests/mpi/hpo_mpi_e2e.py, gradient_refusal)
# runs this file and expects its ENDOPTIMIZER on line 14.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO BFGS
    MAXEVAL 30
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
