# A RESTART block (AFTER_STAGNATION, MAX, METHOD RANDOM, SEED) on
# NLOPT:LN_SBPLX.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB NLOPT
    ALGO LN_SBPLX
    MAXEVAL 60
    RESTART
      AFTER_STAGNATION 3
      MAX 2
      METHOD RANDOM 1
      SEED 13
    ENDRESTART
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
