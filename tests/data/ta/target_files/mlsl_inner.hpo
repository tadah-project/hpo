# NLOPT:G_MLSL_LDS with POPULATION and an INNER block (LN_BOBYQA), seeded
# by the INIT block's SEED alone.

OPTIMIZER
  INIT
    SEED 1717
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB NLOPT
    ALGO G_MLSL_LDS
    MAXEVAL 120
    POPULATION 5
    INNER
      LIB NLOPT
      ALGO LN_BOBYQA
    ENDINNER
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
