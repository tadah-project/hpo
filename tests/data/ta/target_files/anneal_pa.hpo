# TADAH:ANNEAL_PA with THREADS, POPULATION and its PARAM keys.
# HPO/scripts/run_mpi_smoke.sh runs it on 1 and 2 ranks.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB TADAH
    ALGO ANNEAL_PA
    THREADS 2
    POPULATION 16
    SEED 1234
    MAXEVAL 500
    PARAM CORANA ON
    PARAM NS 2
    PARAM NT 1
    PARAM SWEEPS 1
    PARAM ESS_TARGET 0.5
    PARAM T_HOT 0.10
    PARAM T_MIN 0.001
    PARAM RT 0.85
    PARAM STEP_FRAC 0.15
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
