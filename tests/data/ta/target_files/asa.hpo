# ASA:ASA with SEED and PARAM keys in ASA's own spelling.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB ASA
    ALGO ASA
    MAXEVAL 200
    SEED 1234
    PARAM Limit_Generated 200          # align ASA's own budget with MAXEVAL
    PARAM Temperature_Ratio_Scale 1e-4 # slower annealing suits a 200-eval demo
    PARAM Acceptance_Frequency_Modulus 20  # journal progress cadence
    PARAM Curvature_0 1                # skip the O(dim^2) exit curvature sweep
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
