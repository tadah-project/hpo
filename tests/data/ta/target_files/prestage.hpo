# STRATEGY TYPE PRESTAGE: an NLopt EXPLORE block, then NLOPT:LN_BOBYQA from
# its TOPK best points.

OPTIMIZER
  STRATEGY
    TYPE PRESTAGE
    LIB NLOPT
    ALGO LN_BOBYQA
    MAXEVAL 30
    TOPK 3
    EXPLORE
      LIB NLOPT
      ALGO GN_CRS2_LM
      MAXEVAL 60
      SEED 1717
    ENDEXPLORE
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
