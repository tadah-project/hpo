# OPTIM FIXWEIGHT on pinned weights, without a training DBFILE and
# without --validation: the parse case removes DBFILE from
# ../common/config.tadah and pins its 14 weights (FIXINDEX 1-14).

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB NLOPT
    ALGO LN_BOBYQA
    MAXEVAL 40
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

# Search three of the pinned coefficients (weight indices 2-4); the
# remaining ones stay at their fitted values.
OPTIM FIXWEIGHT (2-4) -300.0 300.0

OUTPUT 1
BOUTPUT 1
