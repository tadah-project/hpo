# STRATEGY TYPE MULTISTART (N_STARTS, BUDGET_PER_START) started from an
# INIT block with STRATEGY LHS.

OPTIMIZER
  INIT
    STRATEGY LHS 4
    SEED 11
  ENDINIT
  STRATEGY
    TYPE MULTISTART
    LIB DLIB
    ALGO BFGS
    MAXEVAL 80
    N_STARTS 4
    BUDGET_PER_START 20
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
