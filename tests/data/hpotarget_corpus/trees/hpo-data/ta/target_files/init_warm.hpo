# An INIT block with STRATEGY WARM and WARM_ON_MISMATCH. The parse case
# copies ../common/config.tadah to seed_pot.tadah.

OPTIMIZER
  INIT
    STRATEGY WARM seed_pot.tadah
    WARM_ON_MISMATCH warn
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB NLOPT
    ALGO LN_BOBYQA
    MAXEVAL 30
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
