# ../common/config.tadah with the settings the analytical gradient needs:
# the training configuration of pc_observable.hpo.

DBFILE ../common/data/elastic.tadahdb
DBFILE ../common/data/eos_bcc.tadahdb

INIT2B true
MODEL M_BLR BF_Linear
TYPE2B D2_Blip 7 7 Ta Ta
RCTYPE2B Cut_Poly
SGRID2B  LIN 7 1 1.2
CGRID2B  LIN 7 0.1 3.0
RCUT2B 5.6

INITMB true
TYPEMB DM_mBlipEnv 0 1 1 7 7 Ta Ta
RCUTENV 5.0
RCTYPEMB Cut_Poly
RCUTMB 5.6
SGRIDMB     0.2
CGRIDMB     0.0
SEMBFUNC  1 1 1 1 1 1 1
CEMBFUNC  1 2 3 4 5 6 7

WATOM 1.0
# The analytical gradient (GRAD_STRATEGY ANALYTICAL) differentiates the
# fit through its Cholesky factor: OALGO 4 with a fixed ridge LAMBDA.
OALGO  4
LAMBDA 1e-6
BIAS false
