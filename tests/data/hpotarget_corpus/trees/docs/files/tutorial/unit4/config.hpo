# Target file (--hpotarget): six properties of the crystal, computed by
# LAMMPS for every candidate, join the validation errors of Unit 2 in the
# loss, and the energy error scale of the fit joins the search space.

# The three search parameters and bounds of Unit 2.
OPTIM      RCUT2B (1) 6.0 7.5
OPTIM      RCUTMB (1) 4.0 7.0
OPTIM      SGRIDMB (1) 0.05 1.0 LOG
# The vacancy formation energy is a difference of two cell energies.
# Smaller ESIGMA gives their energy residuals more emphasis in the fit.
# At fixed priorities, 2/sqrt(1000) to 2 meV/atom spans a factor of 1000
# in the energy fit term relative to forces. LOG suits this ratio.
OPTIM      ESIGMA (1) 0.06324555320336758 2 LOG

# Fixed accuracies: 2 meV/atom, 0.1 eV/Å and 0.5 GPa, as in Unit 2.
# Each loss-term weight is 1/accuracy^2, independent of the searched ESIGMA.
PC_ERMSE   0 0.25
PC_FRMSE   0 100
PC_SRMSE_GPA 0 4

# The timeout bounds slow relaxations without loosening their tolerances.
# Each PC_LAMMPS line takes the limit set above it.
PC_SCRIPT_TIMEOUT 60

# Targets are DFT values, with fixed loss-term weights 1/accuracy^2.
# Ecoh 0.1 eV/atom (1.2 %) and a0 0.01 Å (0.3 %) penalise drift of the
# cohesive energy and crystal volume. a0 relaxes from DFT first, later
# from the last a0 inside 3.1-3.5 Å, about 6 % either side of DFT.
# A relaxation outside this range fails its evaluation.
PC_LAMMPS  --script ../../lammps/ecoh_a0.in --hotvar a0 3.1 3.5 3.32011 \
           --varloss Ecoh 8.11398 100 --varloss a0 3.32011 1e4
# Evf accuracy 1/sqrt(10) eV (10.6 %) exceeds the 0.212 eV from two
# cell energies each 2 meV/atom off: 53*0.002 + (53/54)*54*0.002.
# vacancy.in uses the DFT a0, not the relaxed a0 of the potential.
PC_LAMMPS  --script ../../lammps/vacancy.in --invar a0_dft 3.32011 \
           --varloss Evf 2.9873 10
# C11 below C12, or C44 below 0, makes bcc unstable. With 10 GPa for each
# constant a potential at either limit pays more than 50 in these terms.
# elastic.in builds its cell with the a0 of ecoh_a0.in in this evaluation.
PC_LAMMPS  --script ../../lammps/elastic.in --varloss C11 264.2 1e-2 \
           --varloss C12 161.5 1e-2 --varloss C44 74.8 1e-2

OPTIMIZER
    LIB      NLOPT
    # LAMMPS scripts require a gradient-free optimiser. LN_SBPLX uses
    # simplex comparisons rather than a quadratic model of the loss.
    ALGO     LN_SBPLX
    MAXEVAL  100          # 25 per search parameter, as in Units 2 and 3
    # ESIGMA starts at its upper bound. The first simplex edge points
    # inward by a quarter of its LOG range, lowering ESIGMA by 1000^0.125.
    STEP     0.25
    THREADS  1            # one worker: one candidate and one script at a time
ENDOPTIMIZER
