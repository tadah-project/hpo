# Target file (--hpotarget): Unit 2's three search parameters over their
# wider bounds, a global search and then local searches.

# The bounds come from the pair blips and the neighbour shells, not from
# a starting point.
# The pair cutoff from the centre of the outermost pair blip (6.0 Å) to
# 8.0 Å. The blips end at 7.0 Å: above that a larger cutoff adds no
# neighbour to the pair term, it only flattens the cosine taper over the blips.
# The upper bound leaves 1 Å beyond the support for a gentler taper.
OPTIM      RCUT2B (1) 6.0 8.0
# The density cutoff from the second neighbours at a0 (3.32 Å), where the
# density counts the first neighbours only, to past the eighth.
OPTIM      RCUTMB (1) 3.3 8.0
# At the second neighbours exp(-SGRIDMB r^2) is 97 % (0.01) to 6 % (1.0)
# of its value at the first.
OPTIM      SGRIDMB (1) 0.01 1.0 LOG

# Fixed L2 loss-term weights are 1/(chosen accuracy)^2, as in Unit 2.
PC_ERMSE   0 0.25         # 2 meV/atom
PC_FRMSE   0 100          # 0.1 eV/Å
PC_SRMSE_GPA 0 4          # 0.5 GPa

OPTIMIZER
    STRATEGY
        TYPE     PRESTAGE
        # Three local searches: the best point of the exploration may lie
        # in a shallower valley than the second or the third.
        TOPK     3
        # The exploration needs no starting point and draws no random
        # numbers, so the run repeats without SEED.
        EXPLORE
            LIB      NLOPT
            ALGO     GN_DIRECT_L
            MAXEVAL  90       # 30 per search parameter
        ENDEXPLORE
        REFINE
            LIB      NLOPT
            ALGO     LN_BOBYQA
            MAXEVAL  90       # 30 per local search, 10 per parameter
            STEP     0.05     # each start is a good point: short steps
        ENDREFINE
        THREADS  1            # one worker: one candidate at a time
    ENDSTRATEGY
ENDOPTIMIZER
