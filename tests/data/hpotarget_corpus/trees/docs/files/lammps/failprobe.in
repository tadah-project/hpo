# A check for contraction under compression: nine bcc Ta cells span
# a = 2.70-3.10 A. Negative pressure favours further contraction.
# S sums the magnitudes of negative pressures in GPa; it is zero when
# all sampled pressures are non-negative, not a test of full stability.
# The upper end is the lower bound of --hotvar a0 3.1 3.5: every point
# is at or below any accepted a0. Single points avoid a minimisation
# convergence test; a LAMMPS error still fails the evaluation.

# The LAMMPS instance serves the next evaluation too and keeps its
# variables: the sum starts from 0 every time.
variable        Ssum internal 0.0
variable        i loop 9
label           compress
clear
units           metal
atom_style      atomic
boundary        p p p
# Two atoms: every atom of the crystal is equivalent.
lattice         bcc $(2.65+0.05*v_i)    # 2.70, 2.75, ..., 3.10 A
region          box block 0 1 0 1 0 1
create_box      1 box
create_atoms    1 box
mass            1 180.95
pair_style      tadah
pair_coeff      * * EXTERN Ta
# The pressure is computed at the end of the run, so press below is
# the pressure of this cell.
thermo_style    custom step pe press
run             0
variable        Ssum internal $(v_Ssum+ternary(press<0,-press/1e4,0))
next            i
jump            SELF compress
variable        S equal $(v_Ssum)
