# Target file (--hpotarget): the search of Tutorial Unit 2, plus the
# cohesive energy and lattice constant, and a check for negative pressure
# in compressed bcc cells.

# The search space of Unit 2: bounds from the bcc neighbour shells.
OPTIM      RCUT2B (1) 6.0 7.5
OPTIM      RCUTMB (1) 4.0 7.0
OPTIM      SGRIDMB (1) 0.05 1.0 LOG

# Fixed L2 loss-term weights are 1/(chosen accuracy)^2, as in Unit 2.
PC_ERMSE   0 0.25         # 2 meV/atom
PC_FRMSE   0 100          # 0.1 eV/Å
PC_SRMSE_GPA 0 4          # 0.5 GPa

# A loss of 1e4 corresponds to equal normalised errors of 100: far above
# the chosen accuracies. This value precedes the script lines so that both
# scripts use it.
FAILSCORE  1e4
# Grading lets BOBYQA tell a near miss of the check from a far one.
FAILSCORE_GRADING ON

# Any negative pressure under compression fails the evaluation, and
# ecoh_a0.in is skipped. 400 GPa, about the largest DFT pressure in the
# range of failprobe.in, sets the scale of S: it only spreads the losses
# of the evaluations that --gate rejects.
PC_FAILPROBE --script ../../lammps/failprobe.in --outvar S --gate 0 \
             --s0 400
# Chosen accuracies 0.1 eV/atom and 0.01 Å. A crystal that relaxes outside
# 3.1-3.5 Å (about 6 % around the DFT a0) fails, graded by the distance.
PC_LAMMPS  --script ../../lammps/ecoh_a0.in --hotvar a0 3.1 3.5 3.32011 \
           --varloss Ecoh 8.11398 100 --varloss a0 3.32011 1e4

OPTIMIZER
    LIB      NLOPT
    ALGO     LN_BOBYQA
    THREADS  1            # the check finishes before ecoh_a0.in starts
    MAXEVAL  75           # 25 per search parameter, as in Unit 2
    STEP     0.25         # Unit 2's guessed start
ENDOPTIMIZER
