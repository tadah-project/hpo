# Target file (--hpotarget): validation and crystal properties in one loss.
# The loss joins validation errors on three datasets and six properties
# of the crystal; the fit's energy and stress error scales are searched with
# the cutoffs and the density width.

# The box of the pair cutoff begins at the last blip centre. Past 7 Å,
# where the blips end, a larger cutoff changes their taper, not their support.
# The density cutoff and width use the ranges of Unit 2. For the width,
# that range is broader than Unit 3's AUTO box (about 0.076-0.30 Å^-2).
OPTIM      RCUT2B (1) 6.0 7.5
OPTIM      RCUTMB (1) 4.0 7.0
OPTIM      SGRIDMB (1) 0.05 1.0 LOG
# FSIGMA stays at 0.1 eV/Å. Relative to ESIGMA 2 and SSIGMA 0.5,
# reducing either error scale by sqrt(1000) raises its squared-residual
# contribution by 1000. These ranges favour energies and stresses for
# the crystal properties without changing any data priority. LOG gives
# equal intervals to equal ratios. The loss-term weights below stay fixed.
OPTIM      ESIGMA (1) 0.06324555320336758 2 LOG
OPTIM      SSIGMA (1) 0.015811388300841896 0.5 LOG

# Validation errors on the datasets of the validation configuration:
# (1) solid MD, (2) MD with a vacancy, (3) uniaxial strain to 20 %.
# Loss-term weights are 1/(fixed accuracy)^2. The strain accuracies are
# 20 meV/atom and 3 GPa; the elastic constants constrain equilibrium.
PC_ERMSE   (1,2) 0 0.25      # 2 meV/atom
PC_ERMSE   (3) 0 0.0025      # 20 meV/atom
# An indexed term is the mean over the three datasets. The forces of (3)
# are zero by symmetry: loss-term weight 0. At the fixed accuracies the
# force term is 2/3 where the energy term is 1.
PC_FRMSE   (1,2) 0 100       # 0.1 eV/Å
PC_FRMSE   (3) 0 0
# Each dataset has its own fixed stress accuracy, independent of SSIGMA.
PC_SRMSE_GPA (1,2) 0 4      # 0.5 GPa
PC_SRMSE_GPA (3) 0 0.1111111111111111  # 3 GPa

# Properties against the DFT values of the Ta data, with the acceptable
# accuracies of Unit 4: 0.1 eV/atom, 0.01 Å, about 0.3 eV, 10 GPa.
PC_LAMMPS  --script ../../lammps/ecoh_a0.in --hotvar a0 3.1 3.5 3.32011 \
           --varloss Ecoh 8.11398 100 --varloss a0 3.32011 1e4
# vacancy.in builds its cell at the DFT a0, as the DFT value was computed.
PC_LAMMPS  --script ../../lammps/vacancy.in --invar a0_dft 3.32011 \
           --varloss Evf 2.9873 10
# elastic.in strains the crystal at the a0 that ecoh_a0.in relaxes.
PC_LAMMPS  --script ../../lammps/elastic.in --varloss C11 264.2 1e-2 \
           --varloss C12 161.5 1e-2 --varloss C44 74.8 1e-2

OPTIMIZER
    LIB      TADAH
    ALGO     ANNEAL_PT
    # A budget of 240 evaluations per search parameter for five parameters.
    # The four replicas share it: about 300 moves of each.
    MAXEVAL  1200
    # Four replicas at once; the same results at THREADS 1, 2 and 4.
    THREADS  4
    SEED     1
    PARAM    REPLICAS 4
    # The moves and hot temperature of calibrate.hpo. FIXED keeps its
    # STEP_FRAC proposal scales, without a warm-up or second pass.
    PARAM    STEP_MODE FIXED
    PARAM    STEP_FRAC 0.05
    PARAM    T_HOT  1.300
    # A cold-end loss scale of about 3 % of the best loss keeps exchanges
    # across the ladder. A colder end resolves smaller loss differences,
    # but its coldest pair exchanges rarely.
    PARAM    T_COLD 0.2
ENDOPTIMIZER
