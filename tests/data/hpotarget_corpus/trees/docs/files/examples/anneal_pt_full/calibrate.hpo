# Target file (--hpotarget): a short run whose journal (hpo_run.log)
# gives the hot temperature of config.hpo, measured for its moves. The
# search space and the loss are those of config.hpo.

OPTIM      RCUT2B (1) 6.0 7.5
OPTIM      RCUTMB (1) 4.0 7.0
OPTIM      SGRIDMB (1) 0.05 1.0 LOG
OPTIM      ESIGMA (1) 0.06324555320336758 2 LOG
OPTIM      SSIGMA (1) 0.015811388300841896 0.5 LOG

PC_ERMSE   (1,2) 0 0.25
PC_ERMSE   (3) 0 0.0025
PC_FRMSE   (1,2) 0 100
PC_FRMSE   (3) 0 0
PC_SRMSE_GPA (1,2) 0 4
PC_SRMSE_GPA (3) 0 0.1111111111111111

PC_LAMMPS  --script ../../lammps/ecoh_a0.in --hotvar a0 3.1 3.5 3.32011 \
           --varloss Ecoh 8.11398 100 --varloss a0 3.32011 1e4
PC_LAMMPS  --script ../../lammps/vacancy.in --invar a0_dft 3.32011 \
           --varloss Evf 2.9873 10
PC_LAMMPS  --script ../../lammps/elastic.in --varloss C11 264.2 1e-2 \
           --varloss C12 161.5 1e-2 --varloss C44 74.8 1e-2

OPTIMIZER
    LIB      TADAH
    ALGO     ANNEAL_PT
    MAXEVAL  21           # the start and the 20 probes that set T_HOT
    THREADS  4
    SEED     1
    PARAM    REPLICAS 4
    # These are the moves of config.hpo, in the transformed search space.
    # At a twentieth of each range the median uphill rise is below a
    # quarter of the start loss.
    # FIXED keeps these scales: there is no warm-up or second pass.
    PARAM    STEP_MODE FIXED
    PARAM    STEP_FRAC 0.05
ENDOPTIMIZER
