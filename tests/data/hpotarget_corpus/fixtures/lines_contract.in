clear
units           metal
atom_style      atomic
boundary        p p p
lattice         bcc 3.3
region          box block 0 1 0 1 0 1
create_box      1 box
create_atoms    1 box
mass            1 180.95
pair_style      tadah
pair_coeff      * * EXTERN Ta
run             0
variable        E equal $(pe/atoms)
