# Set wall time limit on this script
#timer timeout ${tout}

# ---------- Initialize Simulation --------------------- 
clear 
units metal 
dimension 3 
boundary p p p 
atom_style atomic 
atom_modify map array

# ---------- Create Atoms --------------------- 
lattice 	${structure} ${lata}
region	box block 0 1 0 1 0 1 units lattice
create_box	1 box

lattice	${structure} ${lata} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1  
create_atoms 1 box
replicate 1 1 1

mass 1 1e-20    # to keep lammps happy for some potentials

# ---------- Define Interatomic Potential --------------------- 

pair_style tadah/tadah
pair_coeff * * pot.tadah ${element}
neighbor 2.0 bin 
neigh_modify every 1 delay 0 check yes 
 
# ---------- Define Settings --------------------- 
compute eng all pe/atom 
compute eatoms all reduce sum c_eng 

# ---------- Run Minimization --------------------- 
reset_timestep 0 
thermo 0 
fix   5 all vector 1 c_eatoms
thermo_style custom step pe lx ly lz press pxx pyy pzz c_eatoms 
run 1

variable natoms equal "count(all)" 
variable teng equal "c_eatoms"
variable length equal "lx"
variable ecoh equal "v_teng/v_natoms"

print "======E vs V ============================"
print "Total energy (eV) = ${teng};"
print "Number of atoms = ${natoms};"
print "Lattice constant (Angstoms) = ${length};"
print "Cohesive energy (eV) = ${ecoh};"
print "========================================="
