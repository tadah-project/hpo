clear
# --------------- INITIALIZATION ------------------
units       metal
dimension   3
boundary    p   p    p      
atom_style  atomic

# ------------------ ATOM DEFINITION -------------------
variable Ptarget equal ${P}*10000

lattice         bcc ${ao2}
region      box block -4 4 -4 4 -4 4
create_box  1 box

#lattice     bcc ${ao2}  orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
create_atoms    1 region box
 
mass 1 180    # no need to set it this is just to keep LAMMPS happy
thermo 10

# ------------------------ FORCE FIELDS -----------------------
pair_style tadah/tadah
pair_coeff * * pot.tadah ${element}

#---------------------------Settings----------------------------
compute csym all centro/atom bcc
compute eng all pe/atom 
compute eatoms all reduce sum c_eng

#----------------------Run Minimization-------------------------
reset_timestep 0
fix 3 all box/relax iso ${Ptarget}
thermo_style custom step pe lx ly lz press pxx pyy pzz c_eatoms enthalpy

#dump 1 all custom 1 dump.relax1.${P}.* id type xs ys zs c_csym c_eng 

min_style cg
#min_modify line quadratic dmax 0.05
minimize 1e-15 1e-15 1000 1000

#run 0
#undump 1

#variable N equal count(all), counts the total number of atoms in the cell
#the total number of atoms is stored to the variable N

variable N equal count(all)
variable No equal $N
variable PRESS equal press/10000

#variable Ei equal "c_eatoms" computes the initial energy of the cell system before the vacancy
#E is needed to store the initial energy of the system to the variable Ei

variable E equal "c_eatoms"
variable Ei equal $E
variable H equal enthalpy
variable Hi equal $H

#---------------------------------------------------------------
variable r2 equal sqrt(${ao2}^2+${ao2}^2)/4
region select sphere 0 0 0 ${r2} units box
#r2 is the radius of the copper atom

#region select is a region defined so that all atoms within this region are removed
delete_atoms region select compress yes
#---------------------------------------------------------------------

reset_timestep 0

thermo 10
thermo_style custom step pe lx ly lz press pxx pyy pzz c_eatoms enthalpy

#dump 1 all custom 1 dump.relax2.${P}.* id type xs ys zs c_csym c_eng 

#run 0
min_style cg
#min_modify line quadratic dmax 0.02
minimize 1e-15 1e-15 1000 1000

#variable Ef equal "c_eatoms" computes the final energy of the cell system after the vacancy
#The final energy is stored to the variable Ef 

variable Ef equal "c_eatoms"
variable Hf equal enthalpy

variable Ev equal (${Ef}-((${No}-1)/${No})*${Ei})
variable Hv equal (${Hf}-((${No}-1)/${No})*${Hi})

variable latafinal equal lx

######################################
# SIMULATION DONE
print "========================================="
print "Total number of atoms = ${No}"
print "Initial energy of atoms = ${Ei}"
print "Final energy of atoms = ${Ef}"
print "Pressure = ${PRESS}"
print "Vacancy formation energy = ${Ev}"
print "Vacancy formation enthalpy = ${Hv}"
print "========================================="
