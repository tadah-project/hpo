
# Set wall time limit on this script
timer timeout ${tout}

# This scripts requires optimised lattice parameter!
#variable surface equal 100
#variable lata equal 3.3198243462

units metal
dimension 3
boundary p p p
atom_style atomic

timestep 0.001
thermo 1

if "${surface} == 100" then &
"lattice ${structure} ${lata} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1"
if "${surface} == 110" then &
"lattice ${structure} ${lata} origin 0.0 0.0 0.0 orient x 1 1 0 orient y 0 0 1 orient z 1 -1 0"
if "${surface} == 111" then &
"lattice ${structure} ${lata} origin 0.0 0.0 0.0 orient x 1 1 1 orient y 1 -1 0 orient z 1 1 -2"

if "${surface} == 100" then &
"region box block 0 6 0 3 0 3 units lattice"
if "${surface} == 110" then &
"region box block 0 4 0 3 0 3 units lattice"
if "${surface} == 111" then &
"region box block 0 3 0 3 0 3 units lattice"
#region box block 0 6 0 3 0 3 units lattice
create_box 1 box
create_atoms 1 box

pair_style tadah/tadah
pair_coeff * * pot.tadah ${element}

mass 1 1e-20

compute peatom all pe/atom
compute POTENE all reduce sum c_peatom 

#dump 1 all custom 1 surface_${surface}.dat x y z
#dump_modify 1 format float %.7f
run 0
variable A equal ly*lz

variable p equal pe
variable E_0 equal $p

#print ${E_0}
#print ${A}

# Compute energy for surface
variable etol equal 1.0e-10
variable ftol equal 1.0e-10
variable maxiter equal 1000
variable maxeval equal 10000
change_box all boundary f p p
variable E_S equal pe
minimize ${etol} ${ftol} ${maxiter} ${maxeval}
print "========================================="
print "Surface: (${surface})"
#print "${E_S} ${E_0} ${A}"
variable E_f equal (${E_S}-${E_0})/(2.0*${A})
print "${E_f} eV/A^2"
variable eV equal 1.602176634*1e-19
variable E_f2 equal ${E_f}*${eV}/(1e-20)
print "${E_f2} J/m^2"
print "========================================="
