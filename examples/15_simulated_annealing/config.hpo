# 15 -- classical simulated annealing (TADAH:ANNEAL).
#
# Kirkpatrick/Metropolis SA: fixed-shape Gaussian step in transformed
# parameter space, geometric temperature schedule (T <- T * RT),
# Metropolis acceptance. Initial temperature is auto-calibrated from
# local full-vector Gaussian probes around the seed point (T0_PROBES
# probes; median uphill |dE|, or median absolute |dE| when none is uphill;
# T0_ACCEPT is assigned to that calibration delta).
# The knobs demonstrated here are explicit; supported controls not shown
# retain their shipped defaults.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB TADAH
    ALGO ANNEAL
    MAXEVAL 200
    SEED 1234
    PARAM RT          0.85    # geometric cooling factor in (0,1)
    PARAM CHAIN_LENGTH 20     # CLASSIC proposals per temperature rung
    PARAM STEP_FRAC   0.15    # sigma_i = STEP_FRAC * (high_i - low_i)
    PARAM BOUNDARY_MODE REFLECT      # exact reflection
    PARAM T0_PROBES   20
    PARAM T0_ACCEPT   0.8
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
