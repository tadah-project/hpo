# 14 -- NLOPT MLSL_LDS with an INNER local optimiser.
#
# Multi-Level Single-Linkage with Low-Discrepancy Sampling is itself
# a global+local hybrid: it samples the box on an LDS sequence and
# launches a local descent from each sample, but skips starts that
# fall within the attraction region of an already-found minimum. The INNER block
# specifies the local descent used by MLSL.

OPTIMIZER
  INIT
    SEED 1717
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB NLOPT
    ALGO G_MLSL_LDS
    MAXEVAL 120
    POPULATION 5
    INNER
      LIB NLOPT
      ALGO LN_BOBYQA
    ENDINNER
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
