# 16 -- mixed FIXWEIGHT example: local copy of ../common/config.tadah
# with two pinned linear coefficients.
#
# The shared model has K=14 weights (7 x D2_Blip + 7 x embedding). In the
# unconstrained fit weights 13 and 14 come out exactly 0 on this dataset,
# so pinning them at 0 reproduces the baseline potential at iteration 0:
#   - w13 is held at 0.0 for the whole run (a plain constant), and
#   - w14 is searched by the optimiser (OPTIM FIXWEIGHT (14) in
#     config.hpo) while weights 1-12 are least-squares refitted against
#     the residual target on every evaluation.

DBFILE ../common/data/elastic.tadahdb
DBFILE ../common/data/eos_bcc.tadahdb

INIT2B true
MODEL M_BLR BF_Linear
TYPE2B D2_Blip 7 7 Ta Ta
RCTYPE2B Cut_Poly
SGRID2B  LIN 7 1 1.2
CGRID2B  LIN 7 0.1 3.0
RCUT2B 5.6

INITMB true
TYPEMB DM_mBlipEnv 0 1 1 7 7 Ta Ta
RCUTENV 5.0
RCTYPEMB Cut_Poly
RCUTMB 5.6
SGRIDMB     0.2
CGRIDMB     0.0
SEMBFUNC  1 1 1 1 1 1 1
CEMBFUNC  1 2 3 4 5 6 7

WATOM 1.0
OALGO  1 1e-13
BIAS false

# Pin two of the 14 linear coefficients; the i-th FIXWEIGHT value pins
# the weight named by the i-th FIXINDEX entry.
FIXINDEX  13,14
FIXWEIGHT 0.0 0.0
