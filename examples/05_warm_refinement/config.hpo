# Example 05 — WARM-start refinement.
#
# A previous HPO run wrote `seed_pot.tadah` next to this config. WARM
# reads the optimum back, primes the warmstart `${hot_a0}` cache from
# embedded `# HOT_A0 ...` lines, and refines from there.
#
# To prepare seed_pot.tadah, run any earlier example and rename its
# `best_pot.tadah` -> `05_warm_refinement/seed_pot.tadah`. The example's
# `run.sh` does this automatically when seed_pot.tadah is missing.

OPTIMIZER
  INIT
    STRATEGY WARM seed_pot.tadah
    INCLUDE_CONFIG false
    WARM_ON_MISMATCH warn
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO BFGS
    MAXEVAL 6
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
