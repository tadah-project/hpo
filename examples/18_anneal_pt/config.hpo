# 18 -- parallel tempering (TADAH:ANNEAL_PT).
#
# Four replicas at a static geometric temperature ladder run the Corana
# adaptive stepper concurrently (THREADS worker threads over one
# thread-safe host). A replica runs one sweep (dim single-coordinate
# moves) per epoch; adjacent pairs attempt a state exchange every epoch
# (deterministic even/odd pairing) and each slot's V adjusts every NS
# completed sweeps. REPLICAS is fixed, the objective
# is deterministic, and MAXEVAL is the only active stop, so the same SEED
# gives the same evaluated set for any THREADS. The demonstrated controls
# are explicit below; supported controls not shown retain shipped defaults.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB TADAH
    ALGO ANNEAL_PT
    THREADS 2
    SEED 1234
    MAXEVAL 260
    PARAM CORANA 1
    PARAM NS 3                # sweeps between per-slot V adjustments
    PARAM REPLICAS 4
    PARAM T_HOT  0.10       # pinned: skips T0 calibration
    PARAM T_COLD 0.001
    PARAM SWAP_EVERY 1
    PARAM SWAP_WINDOW 20      # diagnostics window; 0 = cumulative only
    PARAM STEP_FRAC 0.15
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
