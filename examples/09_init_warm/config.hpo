# 10 -- warm restart from a previous best.
#
# Loads the best parameters from a prior run (seed_pot.tadah) and
# refines from there. The seed file also carries the warmstart cache
# for hot LAMMPS variables (e.g. the relaxed lattice constant), so
# every hot script picks up where the prior run's box/relax landed.

OPTIMIZER
  INIT
    STRATEGY WARM seed_pot.tadah
    WARM_ON_MISMATCH warn
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO BFGS
    MAXEVAL 30
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
