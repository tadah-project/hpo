# 21 -- Adaptive Simulated Annealing (ASA:ASA, vendored Ingber ASA-30.53).
#
# Very-fast simulated reannealing: a fat-tailed per-dimension generating
# distribution driven by per-dimension temperatures T_i(k) = T0_i *
# exp(-c_i k^(1/D)), with sensitivity-driven reannealing of the
# parameter temperatures (finite-difference tangents, Delta_X) and a
# separately scheduled cost temperature. PARAM keys use the ORIGINAL
# ASA option spellings (case-sensitive); options not shown keep the
# canonical ASA-README defaults.
#
# ASA runs in the transformed (post-LOG_HP) parameter space like every
# other optimiser; SEED seeds the proposal stream; the INIT seed (none
# here -> OPTIM box centre) auto-sets User_Initial_Parameters.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB ASA
    ALGO ASA
    MAXEVAL 200
    SEED 1234
    PARAM Limit_Generated 200          # align ASA's own budget with MAXEVAL
    PARAM Temperature_Ratio_Scale 1e-4 # slower annealing suits a 200-eval demo
    PARAM Acceptance_Frequency_Modulus 20  # journal progress cadence
    PARAM Curvature_0 1                # skip the O(dim^2) exit curvature sweep
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
