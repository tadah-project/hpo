# Example 11 — Chained init: WARM + LHS + DLIB:GFS.
#
# Combines a previous best (WARM) with broad LHS exploration, then
# feeds all into DLIB:GFS as initial function evaluations. WARM is
# reordered to the chain front automatically.

OPTIMIZER
  INIT
    STRATEGY LHS 3
    STRATEGY WARM seed_pot.tadah
    INCLUDE_CONFIG false
    WARM_ON_MISMATCH warn
    SEED 999
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO GFS
    MAXEVAL 8
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
