# Example 06 — PRIOR seed for first-time use.
#
# When you do not have a known-good seed, ask the descriptor for its
# `suggested_value` (registered per descriptor inside MODELS); fall
# back to the bounds midpoint when the descriptor has none registered.

OPTIMIZER
  INIT
    STRATEGY PRIOR
    INCLUDE_CONFIG false
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO BFGS
    MAXEVAL 6
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
