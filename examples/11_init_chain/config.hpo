# 11 -- chained init: WARM + LHS feeding DLIB:GFS.
#
# Multiple INIT strategies stack in the same block. Here a previous
# best (WARM) is combined with a broader LHS sweep; both feed into
# DLIB:GFS as initial function evaluations. The chain runs in the
# exact order it is written -- WARM is listed first so iter 0 is the
# warm point and the warm-start cache primes before the LHS draws.

OPTIMIZER
  INIT
    STRATEGY WARM seed_pot.tadah
    STRATEGY LHS 3
    WARM_ON_MISMATCH warn
    SEED 999
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO GFS
    MAXEVAL 40
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B (1) 4.0 6.0

OUTPUT 1
BOUTPUT 1
