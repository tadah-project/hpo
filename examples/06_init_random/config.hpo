# 06 -- explicit random starting point.
#
# Default behaviour is "iter 0 = the value in config.tadah". Add an
# INIT block to override: draw the starting point uniformly from
# inside the OPTIM bounds with a reproducible SEED, and drop the
# in-config value.

OPTIMIZER
  INIT
    STRATEGY RANDOM 1
    INCLUDE_CONFIG false
    SEED 2026
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO BFGS
    MAXEVAL 30
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
