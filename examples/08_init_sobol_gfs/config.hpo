# 08 -- Sobol init feeding DLIB:GFS.
#
# Sobol is a deterministic low-discrepancy sequence. The SEED selects
# which K points of it are drawn: block SEED of K points (here points
# 4*31337 ... 4*31337 + 3). Without SEED the block comes from
# std::random_device, so the starting points differ between runs.
# DLIB:GFS is a global Bayesian-style optimiser that ingests every init
# point as an already-evaluated (x, y) pair, tightening its UCB
# criterion from iter 1.

OPTIMIZER
  INIT
    STRATEGY SOBOL 4
    SEED 31337
  ENDINIT
  STRATEGY
    TYPE PLAIN
    LIB DLIB
    ALGO GFS
    MAXEVAL 60
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
