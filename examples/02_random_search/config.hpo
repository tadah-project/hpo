# 02 -- random search baseline (TADAH:RANDOM).
#
# Uniform random sampling inside the bounds. Useful as a baseline:
# if the best loss after N random samples matches what a gradient
# optimiser produces with the same N, the gradient run is getting
# stuck in a poor local minimum.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB TADAH
    ALGO RANDOM
    MAXEVAL 60
    SEED 1234
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
