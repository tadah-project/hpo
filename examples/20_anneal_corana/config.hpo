# 20 -- Corana adaptive simulated annealing (TADAH:ANNEAL, CORANA 1).
#
# The serial annealer with the Corana et al. (1987) adaptive per-dim
# step vector: one-dim-at-a-time proposals, V[i] adapted every NS-cycle
# from the per-dim accept ratio, RESET_TO_BEST (Corana step 7, also used
# by Brommer) on by default under CORANA. T0 is auto-calibrated from
# one-dim probes around the seed (the probe kernel mirrors the proposal
# kernel). The demonstrated controls are explicit below; supported controls
# not shown retain their shipped defaults.

OPTIMIZER
  STRATEGY
    TYPE PLAIN
    LIB TADAH
    ALGO ANNEAL
    SEED 1234
    MAXEVAL 240
    PARAM CORANA 1
    PARAM NS 3
    PARAM NT 2
    PARAM RT 0.85
    PARAM STEP_FRAC 0.15
    PARAM BOUNDARY_MODE 0      # exact reflection
    PARAM T0_PROBES 20
    PARAM T0_PACCEPT 0.8
    PARAM REANNEAL 1
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
