# 12 -- PRESTAGE: global exploration then local refinement.
#
# When the loss surface is multimodal, do not start a local optimiser
# blindly. The PRESTAGE strategy runs an EXPLORE stage first (broad
# global search), keeps the TOPK best candidates, and refines each
# with the outer optimiser. The strategy is one "shot" -- not a loop
# -- and the final best across all refines is preserved.

OPTIMIZER
  STRATEGY
    TYPE PRESTAGE
    LIB DLIB
    ALGO BFGS
    MAXEVAL 30
    TOPK 3
    EXPLORE
      LIB NLOPT
      ALGO GN_CRS2_LM
      MAXEVAL 60
      SEED 1717
    ENDEXPLORE
  ENDSTRATEGY
ENDOPTIMIZER

LOSS L2
FAILSCORE 1e16
PC_ERMSE 0 0.0001
PC_LAMMPS --script ../common/lammps/Ecoh.in --hotvar hot_a0 2.5 4.5 3.302 --varloss Ecoh 8.10 800

OPTIM RCUT2B  (1) 4.0 6.0
OPTIM SGRIDMB (1) 0.1 0.4

OUTPUT 1
BOUTPUT 1
